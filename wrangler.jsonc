{
  "name": "hotel-management-system",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "hotel", "database_id": "local-only-until-deploy", "migrations_dir": "migrations" }
  ],
  // Reset the demo data every night at 03:00 UTC.
  "triggers": { "crons": ["0 3 * * *"] },
  "workers_dev": false,
  "preview_urls": false
}

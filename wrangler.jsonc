{
  "name": "hotel-management-system",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "hotel", "database_id": "399156c7-8b48-4d23-8536-a34f753c0fe1", "migrations_dir": "migrations" }
  ],
  // Reset the demo data every night at 03:00 UTC.
  "triggers": { "crons": ["0 3 * * *"] },
  "routes": [{ "pattern": "hotel.tahamukhtar.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
